# Local settings for the build scripts: build.py at the root, and in harmony/,
# desktop/ and android/ -- and for third/sync.py, which clones the engine
# sources into the same paths the builds read. Copy to .env, which git ignores,
# and uncomment what this machine needs. Android reads its SDK from
# android/local.properties, and only the vcpkg and engine sources from here.
#
# Every setting is YOAI_<NAME> and fills the <NAME> the scripts read. Highest
# wins: YOAI_<NAME> in the environment, then this file, then <NAME> in the
# environment, then the script's default.
#
# Format: KEY=VALUE, no spaces around `=`, # for comments, and a value may be
# wrapped in double quotes. Nothing is expanded, so write paths out in full.
# Only YOAI_ lines are read; anything else here is left to other tools.

# --- Toolchain ---------------------------------------------------------------

# Visual Studio install root. Windows only.
#YOAI_VS_DIR=C:\Program Files\Microsoft Visual Studio\18\Community

# ninja.exe. Windows only; default is the one bundled with Visual Studio.
#YOAI_NINJA=

# vcpkg checkout. Default on Windows is the VS-bundled one, elsewhere ../vcpkg.
#YOAI_VCPKG_ROOT=

# OpenSSL, when CMake's own search misses it. macOS / Linux only.
#YOAI_OPENSSL_ROOT_DIR=

# A host Vulkan SDK, for text-to-speech on the GPU: root `tts`, desktop `qtts`
# and harmony `vulkan`. Default is the VULKAN_SDK the LunarG installer sets.
# Root `tts` builds without it, for the CPU, and warns.
#YOAI_VULKAN_SDK=

# A CUDA Toolkit, for text-to-speech on an NVIDIA GPU: root `tts` only, beside
# Vulkan. Default is the CUDA_PATH the Windows installer sets, then nvcc on
# PATH, then /usr/local/cuda. Root `tts` builds without it and says nothing.
#YOAI_CUDA_PATH=

# --- Engine sources ----------------------------------------------------------
# Default for each is a checkout beside this repo. `python third/sync.py clone`
# fetches them at the pinned commits with the expected patches applied.

# llama.cpp. Root `asr`, desktop and harmony `llama`, and root `tts` and
# `qtts` for its ggml.
#YOAI_LLAMA_SRC=

# qwentts.cpp, for root `tts` and for `qtts`.
#YOAI_QTTS_SRC=

# cosyvoice.cpp, for the CosyVoice3 evaluation build (build.py cosyvoice).
#YOAI_COSYVOICE_SRC=

# MNN, for `mnn`.
#YOAI_MNN_SRC=

# Where harmony assembles the llama SDK. Default is auto-detected.
#YOAI_LLAMA_SDK_DIR=

# --- HarmonyOS ---------------------------------------------------------------

# DevEco Studio or command-line-tools install. Default is read from DevEco's
# own .home marker.
#YOAI_DEVECO_HOME=

# The SDK directory that CONTAINS native/. Default is derived from DEVECO_HOME.
#YOAI_OHOS_SDK_ROOT=
