# build-profile.json5 IS tracked, even though DevEco writes the local debug signing
# block into it (cert paths under ~/.ohos plus store/key passwords). Keeping those
# rewrites out of a commit relies on each clone running, once, before opening the
# project in DevEco:
#     git update-index --skip-worktree examples/harmony/build-profile.json5
# See examples/harmony/README.md § Signing. (A .gitignore rule would be a no-op on a tracked
# file anyway.)
# Unanchored on purpose: ohpm installs into examples/harmony/oh_modules AND
# examples/harmony/entry/oh_modules, and a leading slash would only catch the first.
node_modules/
oh_modules/
/local.properties
/.idea
**/build
/.hvigor
.cxx
# Prebuilt native artifacts, from targets of build.py: <abi>/
# for the core's vcpkg dependencies (`deps`), llama-sdk/<abi>/ for the on-device
# engine (`llama`), and mnn-sdk/<abi>/ for the MNN evaluation lane (`mnn`).
# Hundreds of MB, and reproducible from vcpkg.json and a checkout of llama.cpp
# or MNN respectively.
/prebuilt
# `llama`'s, `qtts`'s and `mnn`'s cached build trees, kept so a re-run is
# incremental.
/.llama-build
/.qtts-build
/.mnn-build
# The bundled voices, copied from the repository's speaker/ by
# entry/hvigorfile.ts on every build. speaker/ is the copy kept in git.
/entry/src/main/resources/rawfile/speaker
/.clangd
/.clang-format
/.clang-tidy
**/.test
/.appanalyzer
**/oh-package-lock.json5

# Signing material. DevEco defaults to writing these under ~/.ohos/config, but its
# file picker will happily put them in the project instead, and a keystore plus the
# password sitting next to it in build-profile.json5 is the whole signing identity.
*.p12
*.cer
*.p7b
*.csr
