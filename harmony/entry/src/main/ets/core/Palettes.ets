export const DEFAULT_PALETTE: string = 'daylight-arctic';

/**
 * The palette with this key, or the default when the key is unknown.
 *
 * The fallback is a second pass rather than a recursive call: these keys
 * come out of persistent storage, and a table that no longer contains its
 * own default should degrade, not overflow the stack.
 */
export function paletteFor(key: string): Palette {
  for (const p of PALETTES) {
    if (p.key === key) {
      return p;
    }
  }
  for (const p of PALETTES) {
    if (p.key === DEFAULT_PALETTE) {
      return p;
    }
  }
  return PALETTES[0];
}

/** A color family: one light palette and one dark one. */
export interface Family {
  key: string;
  /** Localized picker label, e.g. "Amber - warm". */
  label: Resource;
}

export const FAMILIES: Family[] = [
  { key: 'amber', label: $r('app.string.settings_palette_amber') },
  { key: 'arctic', label: $r('app.string.settings_palette_arctic') },
  { key: 'quiet', label: $r('app.string.settings_palette_quiet') },
];

export const DEFAULT_FAMILY: string = 'arctic';

/**
 * The family with this key, or the default when the key is unknown.
 *
 * Exists so a summary elsewhere can name the chosen family in the user's
 * language: Palette.label is the design's own English name and is not a
 * string resource, so it must not be shown to anyone.
 */
export function familyFor(key: string): Family {
  for (const f of FAMILIES) {
    if (f.key === key) {
      return f;
    }
  }
  for (const f of FAMILIES) {
    if (f.key === DEFAULT_FAMILY) {
      return f;
    }
  }
  return FAMILIES[0];
}

/**
 * The palette in force: the requested family's light or dark member.
 *
 * Family and mode are separate controls, so this is where they meet. An
 * unknown family falls back to the default rather than throwing -- the
 * value comes out of persistent storage and can outlive a rename -- and
 * the fallback is a second pass, not recursion, so a table missing its
 * own default degrades instead of overflowing the stack.
 */
export function resolvePalette(family: string, dark: boolean): Palette {
  const want: string = dark ? 'dark' : 'light';
  for (const p of PALETTES) {
    if (p.family === family && p.mode === want) {
      return p;
    }
  }
  for (const p of PALETTES) {
    if (p.family === DEFAULT_FAMILY && p.mode === want) {
      return p;
    }
  }
  return PALETTES[0];
}
