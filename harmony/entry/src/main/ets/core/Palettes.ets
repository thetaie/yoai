export interface Palette {
  key: string;
  /**
   * The design's own name for this palette, e.g. "Daylight Arctic".
   *
   * NOT for display: it is a plain string in one language. Anything the
   * user reads comes from Family.label, which is a string resource. This is
   * here for logs and for talking about a palette in the source.
   */
  label: string;
  /** Family this palette belongs to; the two members differ only in mode. */
  family: string;
  /** 'light' or 'dark' -- also pushed to setColorMode. */
  mode: string;
  /** Three colors that stand for the palette in the picker chip. */
  swatches: string[];
  /** Per-state colors for the record screens. */
  state_ramp: string[];
  bg_page: string;
  bg_surface: string;
  bg_bubble: string;
  bg_overlay: string;
  surface_inverse: string;
  text_primary: string;
