diff --git a/source/backend/vulkan/component/VulkanDevice.cpp b/source/backend/vulkan/component/VulkanDevice.cpp
index 3629078..381b05f 100644
--- a/source/backend/vulkan/component/VulkanDevice.cpp
+++ b/source/backend/vulkan/component/VulkanDevice.cpp
@@ -694,6 +694,15 @@ void VulkanDevice::checkFP16(const std::vector<VkExtensionProperties>& available
             mFP16Info.supportFP16 = true;
             mFP16Info.enabledVulkan12Features.shaderFloat16 = VK_TRUE;
             mFP16Info.enabledVulkan11Features.storageBuffer16BitAccess = VK_TRUE;
+            // UNIFORM blocks are a separate feature from storage buffers, and
+            // the shaders put 16-bit members in both. Enabling only the storage
+            // half leaves every uniform read undefined behaviour: validation
+            // reports VUID-RuntimeSpirv-uniformAndStorageBuffer16BitAccess-06332
+            // and the device is lost shortly after, with VK_ERROR_DEVICE_LOST as
+            // the only clue. Drivers that tolerate it hide the bug completely.
+            if (vk11.uniformAndStorageBuffer16BitAccess == VK_TRUE) {
+                mFP16Info.enabledVulkan11Features.uniformAndStorageBuffer16BitAccess = VK_TRUE;
+            }
             return;
         }
     }
@@ -718,6 +727,10 @@ void VulkanDevice::checkFP16(const std::vector<VkExtensionProperties>& available
             mFP16Info.FP16FromExtension = true;
             mFP16Info.enabledShaderFloat16Int8Features.shaderFloat16 = VK_TRUE;
             mFP16Info.enabled16BitStorageFeatures.storageBuffer16BitAccess = VK_TRUE;
+            // As above, for the extension path.
+            if (khrStorage.uniformAndStorageBuffer16BitAccess == VK_TRUE) {
+                mFP16Info.enabled16BitStorageFeatures.uniformAndStorageBuffer16BitAccess = VK_TRUE;
+            }
             return;
         }
     }
diff --git a/source/backend/vulkan/component/VulkanDevice.hpp b/source/backend/vulkan/component/VulkanDevice.hpp
index 8c3b141..4d2a5c9 100644
--- a/source/backend/vulkan/component/VulkanDevice.hpp
+++ b/source/backend/vulkan/component/VulkanDevice.hpp
@@ -147,6 +147,25 @@ public:
     const VkPhysicalDeviceProperties& proty() const {
         return mDeviceProty;
     }
+
+    // The alignment every sub-allocation in the buffer pools has to satisfy.
+    //
+    // A tensor's offset within its pool is handed straight to
+    // vkUpdateDescriptorSets as a storage buffer offset, so it must be a
+    // multiple of minStorageBufferOffsetAlignment. The pools were built with
+    // nonCoherentAtomSize alone, which is a different limit answering a
+    // different question -- the flush granularity of mapped memory.
+    //
+    // On most desktop drivers the two coincide at 64 and nothing shows. On an
+    // Intel Arc, nonCoherentAtomSize is 1, so the offsets are arbitrary:
+    // validation reports VUID-VkWriteDescriptorSet-descriptorType-00328 on
+    // every descriptor write, and the device is lost a few dispatches later
+    // with no diagnostic beyond VK_ERROR_DEVICE_LOST.
+    VkDeviceSize bufferAlignment() const {
+        const VkDeviceSize atom  = mDeviceProty.limits.nonCoherentAtomSize;
+        const VkDeviceSize store = mDeviceProty.limits.minStorageBufferOffsetAlignment;
+        return atom > store ? atom : store;
+    }
     const VkPhysicalDeviceMemoryProperties& memProty() const {
         return mMemoryProty;
     }
