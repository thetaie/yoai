<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No permissions, deliberately.

      Models are read from the app's own external files directory, which needs
      none and is where `adb push` puts them. Nothing here records audio yet: a
      RECORD_AUDIO prompt would be the first thing a bench asks for and the last
      thing it needs, since every clip in design/voice.md is a file.
    -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bodyclock">

        <!--
          The app. Its state grid, its timer and its rolling window all read the
          day log in the native core, which opens under filesDir on first launch.
        -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Bodyclock">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The measurement bench, from before there was an app -- see
          android/README.md. It keeps its own launcher entry rather than hiding
          behind a debug menu, because the thing it is for is being opened on a
          device next to the app and compared against design/voice.md. Its
          label is what distinguishes the two icons in the drawer, and this
          whole block is what a release manifest drops.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/bench_name"
            android:theme="@style/Theme.Bodyclock">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
